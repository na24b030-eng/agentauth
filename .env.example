# Run `trustcart init-secrets --output .env` to generate the three PEM values.
TRUSTCART_DEMO_AUTH_PRIVATE_KEY_PEM=
TRUSTCART_DEMO_AUTH_PUBLIC_KEY_PEM=
TRUSTCART_AGENT_PRIVATE_KEY_PEM=
TRUSTCART_GEMINI_API_KEY=
TRUSTCART_RAZORPAY_KEY_ID=
TRUSTCART_RAZORPAY_KEY_SECRET=
TRUSTCART_RAZORPAY_WEBHOOK_SECRET=
TRUSTCART_RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
TRUSTCART_MODEL_NAME=gemini-3.5-flash-lite
TRUSTCART_MODEL_THINKING_LEVEL=low

# Inject these at frontend build time for live hosted mode. Without them the UI is a labelled preview.
NEXT_PUBLIC_MERCHANT_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8001
