{
  "name": "agentauth",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "next build",
    "build:pages": "cross-env GITHUB_PAGES=true next build",
    "start": "next start",
    "lint": "eslint app e2e next.config.ts playwright.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env E2E_LIVE_AGENT=1 playwright test --grep @live",
    "demo:record": "powershell -ExecutionPolicy Bypass -File scripts/build_demo_video.ps1",
    "demo:subtitles": "powershell -ExecutionPolicy Bypass -File scripts/add_demo_subtitles.ps1"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "ffmpeg-static": "^5.3.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
